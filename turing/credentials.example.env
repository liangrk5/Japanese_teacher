# 复制到 ~/.config/turing/credentials.env 并填写。环境变量优先于此文件。
# 如果已经配置过日语助手（~/.config/nihongo/credentials.env）或 AI 狼人杀（~/.config/werewolf/credentials.env），
# 不填也会自动沿用那里的网关和 Key。不要把真实凭据提交到仓库。
TURING_BASE_URL=https://your-prism-gateway.example.com/v1
TURING_API_KEY=your-virtual-key
TURING_CALLER=your.caller.psm

# 可选：参与的 AI 模型（按座位轮流分配）
# TURING_MODELS=doubao-seed-2-1-pro-260915,gpt-6-astra
# 只接受默认 temperature 的模型（gpt-6-astra 已内置）
# TURING_NO_TEMPERATURE_MODELS=
# 单次模型调用的上限（秒），超时用兜底回答，游戏不会卡住
# TURING_TIMEOUT=45
