# 复制到 ~/.config/nihongo/credentials.env 并填写；也可以在应用的「设置」页里直接填写。
# 环境变量优先于此文件。不要把真实凭据提交到仓库。
NIHONGO_TEXT_BASE_URL=https://your-prism-gateway.example.com
NIHONGO_TEXT_API_KEY=your-virtual-key
NIHONGO_TEXT_CALLER=your.caller.psm

# 可选：按用途覆盖模型名
# NIHONGO_MODEL_CHAT=gpt-6-astra
# NIHONGO_MODEL_AUDIO=doubao-seed-2-1-lite-260915
# NIHONGO_MODEL_FAST=doubao-seed-2-1-lite-260915
