# 复制到 ~/.config/rulebutterfly/credentials.env 并填写。环境变量优先于此文件。
# 如果已经配置过日语助手（~/.config/nihongo/credentials.env）、AI 狼人杀或找出人类，
# 不填也会自动沿用那里的网关和 Key。不要把真实凭据提交到仓库。
TOWN_BASE_URL=https://your-prism-gateway.example.com/v1
TOWN_API_KEY=your-virtual-key
TOWN_CALLER=your.caller.psm

# 可选：两个模型，第一个扮演资方（镇长、老板、房东），第二个扮演劳方；裁判每天轮换
# TOWN_MODELS=doubao-seed-2-1-pro-260915,gpt-6-astra
# 只接受默认 temperature 的模型（gpt-6-astra 已内置）
# TOWN_NO_TEMPERATURE_MODELS=
# 单次模型调用的上限（秒），超时用兜底行动，游戏不会卡住
# TOWN_TIMEOUT=60
